# Memory Lane Environment Configuration

# Qloo API Settings
# Set to 'true' to use realistic mock data without requiring a Qloo API key
USE_MOCK_QLOO=true
QLOO_API_KEY=
QLOO_API_BASE_URL=https://api.qloo.com/v1

# LLM Provider Settings (for future agent integration, e.g., OpenAI, Anthropic, or Gemini)
LLM_PROVIDER=mock
LLM_API_KEY=

# Server Configuration
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
