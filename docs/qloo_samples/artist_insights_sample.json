      ],
      "members": [],
      "end_year": 2022,
      "is_group": false,
      "biography": "Born in 1929 in Indore, India, Lata Mangeshkar began her singing career in the early 1940s. She was trained in classical music and quickly rose to prominence in the Indian film industry as a playback singer. Over her career, she recorded songs in over thirty-six languages and became a cultural icon. Her voice became synonymous with Bollywood music, and she received numerous awards and honors, including the Bharat Ratna, India's highest civilian award.",
      "known_for": "Her melodious voice, versatility across genres, and being the voice of Indian cinema for over seven decades.",
      "start_year": 1942,
      "description": "Lata Mangeshkar was an iconic Indian playback singer whose career spanned over seven decades. She was renowned for her melodious voice and versatility, singing thousands of songs in multiple Indian languages. She played a pivotal role in shaping the sound of Indian cinema music and was widely regarded as one of the greatest and most influential vocalists in India.",
      "instruments": [
        "Vocals"
